# Copy to .env.local (git-ignored) and fill in. Both are PUBLIC values from Supabase -> Project Settings -> API.
# Use the anon / publishable key ONLY. Never put the service_role / secret key here (the build refuses it).
HOKIEPARK_SUPABASE_URL=
HOKIEPARK_SUPABASE_ANON_KEY=
# Optional: how often the app refreshes counts, in ms (default 15000, minimum 1000)
# HOKIEPARK_POLL_MS=15000

# Optional: the Gemini-backed parking advisor (Ask tab). Needs the two Supabase values above and a deployed `advisor` Edge Function
# (docs/GEMINI_NLP_SPEC.md). Off by default. The Gemini API key itself is NEVER put here: it is a Supabase function secret.
# HOKIEPARK_ADVISOR=1
# New Supabase functions accept only the new key format at their gateway. Paste the PUBLISHABLE key (sb_publishable_...) from
# Project Settings -> API Keys. It is public by design; never the secret key (the build refuses it).
# HOKIEPARK_ADVISOR_KEY=
# Optional override for a local mock or another host (https, or http for localhost):
# HOKIEPARK_ADVISOR_URL=
