# Copy to .env.local (git-ignored) and fill in. Both are PUBLIC values from Supabase -> Project Settings -> API.
# Use the anon / publishable key ONLY. Never put the service_role / secret key here (the build refuses it).
HOKIEPARK_SUPABASE_URL=
HOKIEPARK_SUPABASE_ANON_KEY=
# Optional: how often the app refreshes counts, in ms (default 15000, minimum 1000)
# HOKIEPARK_POLL_MS=15000
